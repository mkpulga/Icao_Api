<TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pacer - wait for the next arrival slot">
<stringProp name="TestPlan.comments">Pauses 0 ms itself; its timer does the waiting. Records no sample.</stringProp>
<intProp name="ActionProcessor.action">1</intProp>
<intProp name="ActionProcessor.target">0</intProp>
<stringProp name="ActionProcessor.duration">0</stringProp>
</TestAction>
<hashTree>
<JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Arrival scheduler (open model, shared by all threads)">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Request n is due when the rate profile has produced n arrivals: a linear ramp from
// RAMP_START_TPS to TARGET_TPS over RAMP_UP_SECONDS, then TARGET_TPS for SUSTAIN_SECONDS.
// Each thread takes the next request number, sleeps until it is due and sends it, so the
// offered rate does not depend on how fast the API answers. When every thread is still
// waiting on the API the next request goes out late; that delay is saved as LAG_MS, and a
// delay above MAX_SCHEDULE_LAG_MS stops the test because the API is not keeping up.
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong

Map plan = (Map) props.get('VP_PLAN')
AtomicBoolean stopping = (AtomicBoolean) props.get('VP_STOPPING')
if (plan == null || stopping == null) {
    log.error('Schedule not initialised: run the whole test plan so the setUp group runs first')
    vars.put('SEND', 'false')
    vars.put('DONE', 'true')
    return 0
}
long now = System.currentTimeMillis()
AtomicLong startRef = (AtomicLong) props.get('VP_START_MS')
startRef.compareAndSet(0L, now + 1000L)
long start = startRef.get()
long slot = ((AtomicLong) props.get('VP_SLOT')).getAndIncrement()
if (stopping.get() || slot &gt;= (long) plan.totalSlots) {
    vars.put('SEND', 'false')
    vars.put('DONE', 'true')
    return 0
}

double r0 = plan.r0
double r1 = plan.r1
double ramp = plan.ramp
double rampArrivals = plan.rampArrivals
double t
if (slot &lt; rampArrivals) {
    double k = (r1 - r0) / ramp
    t = k == 0d ? slot / r0 : (-r0 + Math.sqrt(r0 * r0 + 2d * k * slot)) / k
} else {
    t = ramp + (slot - rampArrivals) / r1
}
boolean inRamp = t &lt; ramp
long due = start + Math.round(t * 1000d)
long lag = Math.max(0L, now - due)
vars.put('SEND', 'true')
vars.put('DONE', 'false')
vars.put('PHASE', inRamp ? 'ramp' : 'sustain')
vars.put('TARGET_TPS_NOW', String.format(Locale.ROOT, '%.2f', inRamp ? r0 + (r1 - r0) * t / ramp : r1))
vars.put('DUE_MS', String.valueOf(due))
vars.put('LAG_MS', String.valueOf(lag))

Map limits = (Map) props.get('VP_LIMITS')
if (lag &gt; (long) limits.maxLagMs &amp;&amp; stopping.compareAndSet(false, true)) {
    String reason = 'SAFETY STOP (schedule lag): request ' + slot + ' would go out ' + lag + ' ms late (MAX_SCHEDULE_LAG_MS=' +
        limits.maxLagMs + '); every load thread is still waiting on the API'
    props.put('VP_STOP_REASON', reason)
    log.error(reason)
    OUT.println(reason + ' - letting requests in flight finish')
    String dir = vars.get('RESULTS_DIR')
    if (dir) new File(dir, 'stop-reason.txt').append(new java.text.SimpleDateFormat('yyyy-MM-dd HH:mm:ss').format(new Date()) + '  ' + reason + System.lineSeparator())
    ctx.getEngine().askThreadsToStop()
    vars.put('SEND', 'false')
    vars.put('DONE', 'true')
    return 0
}
return Math.max(0L, due - now)
</stringProp>
</JSR223Timer>
