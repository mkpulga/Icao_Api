<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="tearDown_write_run_info">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Writes run-info.properties for the summary script: the plan, the baseline and why the run ended.
import java.util.concurrent.atomic.AtomicLong

Map plan = (Map) props.get('VP_PLAN') ?: [:]
def planValue = { String key -&gt; plan[key] == null ? '' : String.valueOf(plan[key]) }
AtomicLong start = (AtomicLong) props.get('VP_START_MS')
String reason = props.get('VP_STOP_REASON') ?: ''
Properties info = new Properties()
info.setProperty('schedule_start_ms', String.valueOf(start == null ? 0L : start.get()))
info.setProperty('ramp_start_tps', planValue('r0'))
info.setProperty('target_tps', planValue('r1'))
info.setProperty('ramp_up_seconds', planValue('ramp'))
info.setProperty('sustain_seconds', planValue('sustain'))
info.setProperty('planned_requests', planValue('totalSlots'))
info.setProperty('max_in_flight', vars.get('MAX_IN_FLIGHT') ?: '')
info.setProperty('target', vars.get('PROTOCOL') + '://' + vars.get('API_HOST') + ':' + vars.get('API_PORT') + vars.get('API_PATH'))
info.setProperty('image_path', vars.get('IMAGE_PATH') ?: '')
info.setProperty('baseline_verdict', props.get('VP_BASELINE_VERDICT') ?: '')
info.setProperty('baseline_md5', props.get('VP_BASELINE_MD5') ?: '')
info.setProperty('baseline_bytes', props.get('VP_BASELINE_BYTES') ?: '')
info.setProperty('strict_body_match', vars.get('STRICT_BODY_MATCH') ?: '')
info.setProperty('stop_reason', reason ?: 'none: the schedule completed')
info.setProperty('end_ms', String.valueOf(System.currentTimeMillis()))
String dir = vars.get('RESULTS_DIR')
if (dir) new File(dir, 'run-info.properties').withOutputStream { info.store(it, 'verifyPhoto stress test') }
OUT.println('[tearDown] ' + (reason ?: 'Schedule completed without a safety stop'))
SampleResult.setResponseData(info.toString(), 'UTF-8')
</stringProp>
</JSR223Sampler>
