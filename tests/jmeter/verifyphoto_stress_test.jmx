<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="setUp_validate_configuration">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Validates the settings and the image, then prepares the state shared by the load threads:
// the arrival schedule, the safety counters and the stop flag. A problem fails this sample,
// which stops the test before any load is sent.
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong
import org.apache.jmeter.services.FileServer

def problems = []
def number = { String name -&gt;
    String raw = (vars.get(name) ?: '').trim()
    if (!raw.isNumber()) {
        problems.add(name + ' must be a number, got [' + raw + ']')
        return 0d
    }
    return raw as double
}

double target = number('TARGET_TPS')
double rampStart = number('RAMP_START_TPS')
double rampSeconds = number('RAMP_UP_SECONDS')
double sustainSeconds = number('SUSTAIN_SECONDS')
double maxInFlight = number('MAX_IN_FLIGHT')
double hardMax = number('HARD_MAX_SECONDS')
if (target &lt;= 0) problems.add('TARGET_TPS must be above 0')
if (rampStart &lt; 0 || rampStart &gt; target) problems.add('RAMP_START_TPS must be between 0 and TARGET_TPS')
if (rampSeconds &lt; 0) problems.add('RAMP_UP_SECONDS must be 0 or more')
if (sustainSeconds &lt;= 0) problems.add('SUSTAIN_SECONDS must be above 0')
if (hardMax &lt; rampSeconds + sustainSeconds + 30) problems.add('HARD_MAX_SECONDS must be at least RAMP_UP_SECONDS + SUSTAIN_SECONDS + 30')
if (maxInFlight &lt; target) problems.add('MAX_IN_FLIGHT must be at least TARGET_TPS')
if (rampSeconds == 0 &amp;&amp; rampStart != target) rampStart = target

File image = FileServer.getFileServer().getResolvedFile(vars.get('IMAGE_PATH'))
if (!image.isFile()) problems.add('IMAGE_PATH not found: ' + image.getAbsolutePath())

def limits = [
    errorPct      : number('ERROR_RATE_PERCENT'),
    window        : (long) number('ERROR_WINDOW'),
    minSamples    : (long) number('ERROR_MIN_SAMPLES'),
    maxConsecFail : (long) number('MAX_CONSECUTIVE_FAILURES'),
    maxTimeouts   : (long) number('MAX_TIMEOUTS_IN_WINDOW'),
    slowMs        : (long) number('SLOW_RESPONSE_MS'),
    maxConsecSlow : (long) number('MAX_CONSECUTIVE_SLOW'),
    maxLagMs      : (long) number('MAX_SCHEDULE_LAG_MS'),
    maxBadVerdicts: (long) number('MAX_BAD_VERDICTS')
]
if (limits.window &lt; 1) problems.add('ERROR_WINDOW must be at least 1')

if (problems) {
    String text = problems.join('; ')
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage(text)
    SampleResult.setResponseData(text, 'UTF-8')
    OUT.println('[setUp] CONFIGURATION PROBLEM: ' + text)
    return
}

// Cumulative arrivals of a linear ramp from r0 to r1 over R seconds: (r0 + r1) / 2 * R.
double rampArrivals = (rampStart + target) / 2d * rampSeconds
long totalSlots = (long) Math.floor(rampArrivals + target * sustainSeconds)
props.put('VP_PLAN', [r0: rampStart, r1: target, ramp: rampSeconds, sustain: sustainSeconds,
                      rampArrivals: rampArrivals, totalSlots: totalSlots])
props.put('VP_LIMITS', limits)
props.put('VP_START_MS', new AtomicLong(0L))
props.put('VP_SLOT', new AtomicLong(0L))
props.put('VP_STOPPING', new AtomicBoolean(false))
props.put('VP_STOP_REASON', '')
props.put('VP_STOP_CHECKED_MS', new AtomicLong(0L))
// state: 0 completed, 1 consecutive failures, 2 consecutive slow, 3 failures in window,
//        4 timeouts in window, 5 invalid or inconsistent verdicts in the run
props.put('VP_SAFETY', [failed: new int[(int) limits.window], timedOut: new int[(int) limits.window], state: new long[6]])

String info = String.format(Locale.ROOT,
    'ramp %.1f to %.1f TPS over %.0f s, then %.1f TPS for %.0f s: %d requests, at most %.0f in flight. Image %s (%d bytes)',
    rampStart, target, rampSeconds, target, sustainSeconds, totalSlots, maxInFlight, image.getAbsolutePath(), image.length())
OUT.println('[setUp] Plan: ' + info)
SampleResult.setResponseData(info, 'UTF-8')
</stringProp>
</JSR223Sampler>
