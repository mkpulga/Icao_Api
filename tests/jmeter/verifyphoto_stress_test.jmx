<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Successful verification check (every verifyPhoto sampler)">
<stringProp name="TestPlan.comments">At plan level so the baseline and load requests share one definition of success.</stringProp>
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Decides whether a verifyPhoto response is a successful verification. HTTP 200 alone is not
// enough: the API also answers 200 when the check itself failed, with the error text in
// result.message. A success needs all of:
//   - HTTP 200
//   - result.message is a verdict: verified or unverified
//   - a complete base64 image field
//   - the expected verdict (EXPECTED_MESSAGE, or else the baseline request's verdict)
//   - with STRICT_BODY_MATCH=true, a body identical (MD5) to the baseline response
// The failure class (FAIL_CLASS) and the verdict (VERDICT) are saved with each sample.
import java.security.MessageDigest

String label = prev.getSampleLabel()
if (!label.startsWith('verifyPhoto')) return
boolean baseline = label == 'verifyPhoto_baseline'
byte[] body = prev.getResponseData()
if (body == null) body = new byte[0]
String code = prev.getResponseCode() ?: ''
String failClass = null
String detail = ''
String verdict = ''

if (!code.isInteger()) {
    String text = (prev.getResponseMessage() ?: '') + ' ' + new String(body, 0, Math.min(body.length, 300), 'UTF-8')
    failClass = (text =~ /(?i)timed out|timeout/) ? 'TIMEOUT' : 'CONNECTION_ERROR'
    detail = code + ' ' + text.trim()
} else if (code != '200') {
    failClass = 'HTTP_' + code
    detail = new String(body, 0, Math.min(body.length, 300), 'UTF-8')
} else {
    String head = new String(body, 0, Math.min(body.length, 4096), 'UTF-8')
    String tail = new String(body, Math.max(0, body.length - 2), Math.min(2, body.length), 'UTF-8')
    def match = head =~ /"message":"((?:[^"\\]|\\.)*)"/
    if (!match.find()) {
        failClass = 'INVALID_RESPONSE'
        detail = 'no result.message: ' + head.take(200)
    } else {
        verdict = match.group(1)
        if (!(verdict in ['verified', 'unverified'])) {
            failClass = 'INVALID_VERDICT'
            detail = verdict
        } else if (!head.contains('"base64":"') || tail != '"}') {
            failClass = 'INVALID_RESPONSE'
            detail = 'base64 image missing or truncated (' + body.length + ' bytes)'
        }
    }
}

if (failClass == null) {
    String expected = (vars.get('EXPECTED_MESSAGE') ?: '').trim()
    if (baseline) {
        props.put('VP_BASELINE_VERDICT', verdict)
        props.put('VP_BASELINE_MD5', MessageDigest.getInstance('MD5').digest(body).encodeHex().toString())
        props.put('VP_BASELINE_BYTES', String.valueOf(body.length))
        if (expected &amp;&amp; expected != verdict) {
            failClass = 'VERDICT_MISMATCH'
            detail = 'baseline verdict ' + verdict + ' but EXPECTED_MESSAGE=' + expected
        }
    } else {
        if (!expected) expected = props.get('VP_BASELINE_VERDICT') ?: ''
        if (expected &amp;&amp; verdict != expected) {
            failClass = 'VERDICT_MISMATCH'
            detail = 'verdict ' + verdict + ', expected ' + expected
        } else if (vars.get('STRICT_BODY_MATCH') == 'true' &amp;&amp; props.get('VP_BASELINE_MD5')) {
            String md5 = MessageDigest.getInstance('MD5').digest(body).encodeHex().toString()
            if (md5 != props.get('VP_BASELINE_MD5')) {
                failClass = 'BODY_MISMATCH'
                detail = body.length + ' bytes (baseline ' + props.get('VP_BASELINE_BYTES') + '), MD5 differs from the baseline response'
            }
        }
    }
}

vars.put('VERDICT', verdict)
vars.put('FAIL_CLASS', failClass ?: '')
if (failClass != null) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failClass + ': ' + detail.take(300))
}
</stringProp>
</JSR223Assertion>
