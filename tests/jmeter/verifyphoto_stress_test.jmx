<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="verifyPhoto_baseline">
<stringProp name="TestPlan.comments">One request before the load. Its verdict and body become the expected result of every load request.</stringProp>
