<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Face license engine is valid">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// verifyPhoto needs the face (IFace) engine. The API loads the license once at startup and
// answers every verifyPhoto request with HTTP 400 when it is not valid.
import groovy.json.JsonSlurper

String problem = null
try {
    def status = new JsonSlurper().parseText(prev.getResponseDataAsString())
    if (status?.face?.valid != true)
        problem = 'face license not valid: ' + (status?.face?.error ?: status?.message ?: 'no detail')
} catch (e) {
    problem = 'checkLicense did not return license JSON (HTTP ' + prev.getResponseCode() + '): ' + e.message
}
if (problem) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(problem)
    OUT.println('[setUp] ' + problem)
}
</stringProp>
</JSR223Assertion>
<hashTree>
</hashTree>
