<JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="Safety monitor (graceful automatic stop)">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Asks JMeter to stop gracefully (nothing new is sent; requests in flight finish or time out)
// on the first of:
//   - more than ERROR_RATE_PERCENT of the last ERROR_WINDOW requests failed (once
//     ERROR_MIN_SAMPLES requests have completed)
//   - MAX_CONSECUTIVE_FAILURES failed requests in a row (API down or refusing)
//   - MAX_TIMEOUTS_IN_WINDOW timeouts within the last ERROR_WINDOW requests (API unresponsive)
//   - MAX_CONSECUTIVE_SLOW responses in a row slower than SLOW_RESPONSE_MS (API stalling)
//   - MAX_BAD_VERDICTS invalid or inconsistent verification results in the run
//   - STOP_FILE exists (written by monitor-resources.ps1 on a CPU, memory, handle or process
//     limit, or by stop-test.ps1); checked at most every 2 seconds
// The schedule-lag stop lives in the arrival scheduler.
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicLong

def result = sampleEvent.getResult()
if (!result.getSampleLabel().startsWith('verifyPhoto_')) return
AtomicBoolean stopping = (AtomicBoolean) props.get('VP_STOPPING')
Map safety = (Map) props.get('VP_SAFETY')
Map limits = (Map) props.get('VP_LIMITS')
if (stopping == null || safety == null || stopping.get()) return

String failClass = vars.get('FAIL_CLASS') ?: ''
boolean failed = !result.isSuccessful()
boolean timedOut = failClass == 'TIMEOUT'
boolean badVerdict = failClass in ['INVALID_VERDICT', 'VERDICT_MISMATCH', 'BODY_MISMATCH', 'INVALID_RESPONSE']
String reason = null
synchronized (safety) {
    int[] failedRing = (int[]) safety.failed
    int[] timeoutRing = (int[]) safety.timedOut
    long[] s = (long[]) safety.state
    int i = (int) (s[0] % failedRing.length)
    if (s[0] &gt;= failedRing.length) {
        s[3] -= failedRing[i]
        s[4] -= timeoutRing[i]
    }
    failedRing[i] = failed ? 1 : 0
    timeoutRing[i] = timedOut ? 1 : 0
    s[3] += failedRing[i]
    s[4] += timeoutRing[i]
    s[0]++
    s[1] = failed ? s[1] + 1 : 0
    s[2] = result.getTime() &gt; (long) limits.slowMs ? s[2] + 1 : 0
    if (badVerdict) s[5]++

    long filled = Math.min(s[0], (long) failedRing.length)
    double failedPct = 100d * s[3] / filled
    if (s[5] &gt;= (long) limits.maxBadVerdicts)
        reason = 'verification results: ' + s[5] + ' invalid or inconsistent (MAX_BAD_VERDICTS=' + limits.maxBadVerdicts + '); last: ' + result.getFirstAssertionFailureMessage()
    else if (s[1] &gt;= (long) limits.maxConsecFail)
        reason = 'failures: ' + s[1] + ' in a row (MAX_CONSECUTIVE_FAILURES=' + limits.maxConsecFail + '); last: ' + result.getResponseCode() + ' ' + failClass
    else if (s[4] &gt;= (long) limits.maxTimeouts)
        reason = 'timeouts: ' + s[4] + ' in the last ' + filled + ' requests (MAX_TIMEOUTS_IN_WINDOW=' + limits.maxTimeouts + ')'
    else if (filled &gt;= (long) limits.minSamples &amp;&amp; failedPct &gt; (double) limits.errorPct)
        reason = String.format(Locale.ROOT, 'error rate: %.1f%% of the last %d requests failed (ERROR_RATE_PERCENT=%s)', failedPct, filled, limits.errorPct)
    else if (s[2] &gt;= (long) limits.maxConsecSlow)
        reason = 'slow responses: ' + s[2] + ' in a row over ' + limits.slowMs + ' ms (MAX_CONSECUTIVE_SLOW=' + limits.maxConsecSlow + ')'
}

if (reason == null) {
    String stopFile = vars.get('STOP_FILE')
    AtomicLong checked = (AtomicLong) props.get('VP_STOP_CHECKED_MS')
    long now = System.currentTimeMillis()
    long last = checked.get()
    if (stopFile &amp;&amp; now - last &gt;= 2000L &amp;&amp; checked.compareAndSet(last, now)) {
        File f = new File(stopFile)
        if (f.isFile()) reason = 'stop file ' + f.getAbsolutePath() + ': ' + (f.getText('UTF-8').replace('﻿', '').trim() ?: 'no reason given')
    }
}

if (reason != null &amp;&amp; stopping.compareAndSet(false, true)) {
    reason = 'SAFETY STOP (' + reason + ')'
    props.put('VP_STOP_REASON', reason)
    log.error(reason)
    OUT.println(reason + ' - letting requests in flight finish')
    String dir = vars.get('RESULTS_DIR')
    if (dir) new File(dir, 'stop-reason.txt').append(new java.text.SimpleDateFormat('yyyy-MM-dd HH:mm:ss').format(new Date()) + '  ' + reason + System.lineSeparator())
    ctx.getEngine().askThreadsToStop()
}
</stringProp>
</JSR223Listener>
