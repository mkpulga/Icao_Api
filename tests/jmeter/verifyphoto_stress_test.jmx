<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Print the baseline">
<stringProp name="scriptLanguage">groovy</stringProp>
<stringProp name="parameters"></stringProp>
<stringProp name="filename"></stringProp>
<stringProp name="cacheKey">true</stringProp>
<stringProp name="script">// Runs before the assertion, so this shows what the API returned, not the verdict check.
String head = new String(prev.getResponseData(), 0, Math.min(prev.getResponseData().length, 120), 'UTF-8')
OUT.println('[setUp] Baseline: HTTP ' + prev.getResponseCode() + ', ' + prev.getBytesAsLong() + ' bytes, ' + prev.getTime() + ' ms: ' + head)
</stringProp>
</JSR223PostProcessor>
